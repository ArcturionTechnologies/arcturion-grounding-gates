#!/usr/bin/env python3
"""Run a gate without installing the package: grounding-hook <gate> [--format json]."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from grounding_gates.cli import main  # noqa: E402

sys.exit(main(["hook", *sys.argv[1:]]))
